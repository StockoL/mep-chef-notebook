{
  "_notes": [
    "Starter test set for the step parser. Each case is one line as a chef might write it, plus what the parser should read from it.",
    "Components are based on dishes from Cedar 1905's published menus (a la carte, Sunday lunch, breakfast, dessert) at dumbletonhall.co.uk. Methods and times are typical kitchen estimates, NOT the house's recipes: correct them once you've seen how the kitchen does it.",
    "Fields left out mean null/empty. minutes.max = null means 'at least min'. 'overnight' is read as min 480.",
    "modes: active (hands busy), check-in (hands-off but needs attention), passive (unattended).",
    "flags: needs-estimate (no time given), service (done to order, not prep), multi-step (one line, several steps: expected is a list), relative-time (time depends on the step before), template-ref (points to another recipe's method), no-gap (must follow the previous step immediately), previous-day (hold long enough to push the start to an earlier day).",
    "Equipment vocabulary: oven, hob, grill, water-bath, fridge, blast-chiller, blender, mixer, bench."
  ],
  "cases": [
    { "id": 1, "recipe": "Brown stock", "for": "Red wine sauce, lamb jus",
      "text": "Roast bones 220c 40-45 min till dark",
      "expected": [{ "mode": "passive", "minutes": { "min": 40, "max": 45 }, "equipment": "oven", "setting": "220°C", "scales_with": "bones" }] },
    { "id": 2, "recipe": "Brown stock",
      "text": "Mirepoix in, tom puree, roast 15 more",
      "expected": [{ "mode": "passive", "minutes": { "min": 15, "max": 15 }, "equipment": "oven", "setting": "220°C", "flags": ["relative-time"] }] },
    { "id": 3, "recipe": "Brown stock",
      "text": "Deglaze tray w/ red wine, scrape",
      "expected": [{ "mode": "active", "equipment": "hob", "flags": ["needs-estimate"] }] },
    { "id": 4, "recipe": "Brown stock",
      "text": "Cover w/ cold water, bring to boil, skim",
      "expected": [{ "mode": "check-in", "equipment": "hob", "flags": ["needs-estimate"] }] },
    { "id": 5, "recipe": "Brown stock",
      "text": "Simmer 6-8 hrs, skim every hour",
      "expected": [{ "mode": "check-in", "minutes": { "min": 360, "max": 480 }, "equipment": "hob", "check_every": 60 }] },
    { "id": 6, "recipe": "Brown stock",
      "text": "Pass thru chinois + muslin",
      "expected": [{ "mode": "active", "equipment": "bench", "flags": ["needs-estimate"] }] },
    { "id": 7, "recipe": "Brown stock",
      "text": "Blast chill, under 8c within 90 min",
      "expected": [{ "mode": "passive", "minutes": { "min": 90, "max": 90 }, "equipment": "blast-chiller", "setting": "8°C", "critical": "cooling" }] },
    { "id": 8, "recipe": "Brown stock",
      "text": "Holds 3 days in walk-in, freeze rest",
      "expected": [{ "hold": { "days": 3, "where": "fridge" } }] },

    { "id": 9, "recipe": "Red wine sauce", "for": "9oz sirloin",
      "text": "Sweat shallots in butter 10 min no colour",
      "expected": [{ "mode": "check-in", "minutes": { "min": 10, "max": 10 }, "equipment": "hob" }] },
    { "id": 10, "recipe": "Red wine sauce",
      "text": "Red wine + port in, reduce to syrup",
      "expected": [{ "mode": "check-in", "equipment": "hob", "flags": ["needs-estimate"] }] },
    { "id": 11, "recipe": "Red wine sauce",
      "text": "Add 2L @brown stock, reduce by 2/3, 45 min-1h",
      "expected": [{ "mode": "check-in", "minutes": { "min": 45, "max": 60 }, "equipment": "hob", "depends_on": ["Brown stock"], "scales_with": "brown stock" }] },
    { "id": 12, "recipe": "Red wine sauce",
      "text": "Mount w/ cold butter to order",
      "expected": [{ "mode": "active", "equipment": "hob", "flags": ["service", "needs-estimate"] }] },

    { "id": 13, "recipe": "House butter", "for": "9oz sirloin",
      "text": "Soften butter, beat in herbs, shallot, anchovy",
      "expected": [{ "mode": "active", "equipment": "mixer", "flags": ["needs-estimate"] }] },
    { "id": 14, "recipe": "House butter",
      "text": "Roll in clingfilm into logs, chill min 2 hrs",
      "expected": [
        { "mode": "active", "equipment": "bench", "flags": ["needs-estimate"] },
        { "mode": "passive", "minutes": { "min": 120, "max": null }, "equipment": "fridge" }
      ], "flags": ["multi-step"] },

    { "id": 15, "recipe": "Brown butter gnocchi",
