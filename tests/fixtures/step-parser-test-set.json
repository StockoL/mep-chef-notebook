        { "mode": "check-in", "minutes": { "min": 20, "max": 20 }, "equipment": "hob" },
        { "mode": "active", "equipment": "blender", "flags": ["needs-estimate"] },
        { "mode": "active", "equipment": "bench", "flags": ["needs-estimate"] }
